# Never commit a real secret.
SATQUERY_ENVIRONMENT=production
SATQUERY_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
SATQUERY_REQUIRE_API_KEY=true

GEOCHAT_REPO=/content/GeoChat
GEOCHAT_MODEL_PATH=/kaggle/input/datasets/sreenidhirvns/satquery-geochat-7b

TASK12_ADAPTER_PATH=/kaggle/input/datasets/sreenidhirvns/satquery-adapter-backup/adapter
TASK3_ADAPTER_PATH=/kaggle/input/datasets/sreenidhirvns/satquery-task3-change-lora/adapter
TASK4_ADAPTER_PATH=/kaggle/input/datasets/sreenidhirvns/satquery-task4-lora/adapter

BIGEARTHNET_PARQUET_PATH=/kaggle/input/datasets/sreenidhirvns/satquery-bigearthnet/BigEarthNet.txt.parquet
BIGEARTHNET_ROOT=/kaggle/input/datasets/sreenidhirvns/satquery-bigearthnet/ben-ge-8k/ben-ge-8k
SECOND_ROOT=/kaggle/input/datasets/sreenidhirvns/satquery-second/SECOND_train_set

SATQUERY_DEVICE=cuda
SATQUERY_MAX_NEW_TOKENS=128
SATQUERY_MAX_UPLOAD_BYTES=10485760
SATQUERY_MAX_IMAGE_PIXELS=25000000

SATQUERY_HOST=0.0.0.0
SATQUERY_PORT=8000
SATQUERY_CORS_ORIGINS=http://localhost:3000
