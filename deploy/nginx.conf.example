# Example production reverse-proxy layout.
# Replace /var/www/satquery/frontend/dist with your actual frontend build path.
# Keep FastAPI private on 127.0.0.1:8000.
#
# If API-key authentication is enabled, inject the secret here on the server
# rather than exposing it to React/Vite/browser code.

server {
    listen 443 ssl http2;
    server_name your-domain.example;

    # Configure your certificate/key with your deployment's TLS setup.
    # ssl_certificate     /etc/letsencrypt/live/your-domain/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/your-domain/privkey.pem;

    root /var/www/satquery/frontend/dist;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Optional defense-in-depth when SATQUERY_REQUIRE_API_KEY=true:
        # proxy_set_header X-API-Key "SERVER_SIDE_SECRET";
    }
}
